# Phase-2 unified gate : NN nodes + FFN sequencer over the parallel link (LINK_SS).
SIM           ?= icarus
TOPLEVEL_LANG ?= verilog
RTL := $(abspath ../../src)
NN  ?= 2

VERILOG_SOURCES += $(abspath ../models/Gowin_rPLL.v)
VERILOG_SOURCES += $(abspath ../models/MULTALU18X18.v)
VERILOG_SOURCES += $(abspath ../models/sdram_chip.v)
VERILOG_SOURCES += $(RTL)/mac18.v
VERILOG_SOURCES += $(RTL)/rmsnorm_op.v
VERILOG_SOURCES += $(RTL)/silu_op.v
VERILOG_SOURCES += $(RTL)/rope_op.v
VERILOG_SOURCES += $(RTL)/softmax_op.v
VERILOG_SOURCES += $(RTL)/attention_head_op.v
VERILOG_SOURCES += $(RTL)/sdram.v
VERILOG_SOURCES += $(abspath async_fifo.v)
VERILOG_SOURCES += $(abspath uart_bridge.v)
VERILOG_SOURCES += $(abspath vec_alu2.v)
VERILOG_SOURCES += $(RTL)/top.v
VERILOG_SOURCES += $(abspath ../ffn_tp_seq2.v)
VERILOG_SOURCES += $(abspath ffn_seq2_ss_top.v)

COMPILE_ARGS += -DLINK_SS
COMPILE_ARGS += -I$(RTL)
COMPILE_ARGS += -Pffn_seq2_ss_top.NN=$(NN)

TOPLEVEL := ffn_seq2_ss_top
MODULE   ?= test_ffn_tp_seq2

# NOTE: rmsnorm/silu/softmax $readmemh their LUTs by RELATIVE path, so the *.hex
# files (rsqrt_lut, silu_lut, exp_lut, inv_lut) MUST be copied into this cwd
# before running, else the ops silently compute X (a missing rsqrt_lut makes
# rmsnorm output X -> all-X result). Use ./run_ss.sh which copies them first,
# or run:  cp -f ../../src/*.hex . && make -f Makefile.ffnss NN=<n>

include $(shell cocotb-config --makefiles)/Makefile.sim
